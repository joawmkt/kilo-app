# Copiá este archivo a .env.local y completá con tus credenciales reales.
# .env.local NUNCA se sube al repo (ya está en .gitignore por defecto de Next.js).

# Supabase → Project Settings → API
SUPABASE_URL=https://TU-PROYECTO.supabase.co
SUPABASE_SERVICE_ROLE_KEY=TU_SERVICE_ROLE_KEY

# Esta es la única clave que SÍ puede quedar expuesta en el navegador
# (está protegida por Row Level Security). La usaremos cuando armemos
# el panel de login del carnicero.
NEXT_PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=TU_ANON_KEY

# Twilio → Console → Account Info
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=TU_AUTH_TOKEN
